# Workflow-agnostic shell aliases. A plain function so a consumer can reuse
# the exact set outside the programs module (for example in a second macOS
# account) without importing the rest of the shell configuration.
#
# `repo` is the checkout, `flakeDir` the directory with its flake.nix, both as
# shell paths ("~/dotfiles"). `churnyInputs` are the inputs `nfu` updates.
{
  churnyInputs,
  repo,
  flakeDir,
  gitConfigFile ? flakeDir,
}:

let
  churny = if builtins.isList churnyInputs then toString churnyInputs else churnyInputs;
in
{
  home = "cd ~";
  dotfiles = "cd ${repo}";
  # ~/.zshrc is a read-only store link, so reload it rather than edit it.
  # exec, not source: re-sourcing stacks PATH and plugin init on the old shell.
  mzsh = "exec zsh";
  gitconfig = "$EDITOR ${gitConfigFile}";
  awsconfig = "$EDITOR ~/.aws/config";
  tool-versions = "$EDITOR ~/.tool-versions";
  upgrade = "mise upgrade";
  nix-config = "cd ${flakeDir}";
  # Works from any directory. A system flake's build app resolves `.#` and
  # `./result` against the working directory, so run it from the flake
  # directory, in a subshell that leaves the caller's directory alone. The
  # anonymous function receives `nb`'s arguments: nb --show-trace.
  nb = ''() { (cd ${flakeDir} && nix run .#build -- "$@") }'';
  nc = "cd ${flakeDir}";
  nfu = "nix flake update ${churny} --flake ${flakeDir} && git -C ${flakeDir} commit flake.lock -m 'flake.lock'";
  nfa = "nix flake update --flake ${flakeDir} && git -C ${flakeDir} commit flake.lock -m 'flake.lock'";
  # The per-machine AI instruction file is generated by Nix at build time
  # (modules/ai-local-docs.nix); this just shows the current one.
  aidocs = "cat ~/CLAUDE.local.md";
  ayolo = "agy --dangerously-skip-permissions";
  yolo = "claude --dangerously-skip-permissions";
  cyolo = "codex --dangerously-bypass-approvals-and-sandbox";
}
