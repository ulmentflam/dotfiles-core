# macOS GUI applications for a Mac without nix-darwin.
#
# Two sources, chosen per app:
#
#   brewfile  Homebrew casks, written to ~/.config/homebrew/Brewfile and
#             applied with plain `brew bundle` (HOMEBREW_BUNDLE_FILE points at
#             it). The default for GUI apps: casks install into /Applications,
#             keep their own auto-updaters (browser and chat-client security
#             fixes land when the vendor ships them, not when nixpkgs catches
#             up), and keep a stable path and signature, so macOS privacy
#             grants (Accessibility, Screen Recording) survive updates. Apps
#             that only work from /Applications, such as 1Password's browser
#             integration, need this.
#   apps      nixpkgs packages, copied into ~/Applications/Home Manager Apps
#             (targets.darwin.copyApps, which Spotlight indexes). Pinned and
#             rolled back with the rest of the generation. Prefer vendor-built
#             `-bin` packages: an app nixpkgs compiles is ad-hoc signed and
#             loses its privacy grants on every rebuild.
#
# App preferences: Maccy (clipboard history, the open-source stand-in for
# Paste) gets Paste's interaction: Command-Shift-V opens the history and
# choosing an item pastes it. Thaw (menu bar manager, the maintained Ice fork,
# the stand-in for Bartender) needs no defaults; grant it Accessibility and
# Screen Recording on first launch. Keys are written one by one with
# `defaults write`: targets.darwin.defaults uses `defaults import`, which
# replaces the whole domain and would reset every other setting on each switch.
#
# Touch ID for sudo lives in /etc/pam.d/sudo_local, which Home Manager cannot
# write. `nix run .#touchid-sudo` (lib.mkHomeApps) writes it once; it survives
# macOS updates. Activation only reports when it is missing.
#
# Activation never runs brew: a cask that fails to upgrade must not fail the
# Home Manager switch. `nbs` runs `brew bundle` after a successful switch, and
# nothing here uninstalls, so apps installed by hand or by device management
# stay put.
{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.dotfiles.darwin;
  bf = cfg.brewfile;
  quote = s: ''"${s}"'';
  brewfileText = lib.concatStringsSep "\n" (
    [ "# Generated by Home Manager (dotfiles-core modules/darwin-apps.nix). Do not edit." ]
    ++ map (t: "tap ${quote t}") bf.taps
    ++ map (b: "brew ${quote b}") bf.brews
    ++ map (c: "cask ${quote c}") bf.casks
    ++ [ "" ]
  );
in
{
  options.dotfiles.darwin = {
    maccy.enable = lib.mkOption {
      type = lib.types.bool;
      default = builtins.elem "maccy" bf.casks;
      defaultText = lib.literalMD "`true` when the Brewfile lists the `maccy` cask";
      description = "Give Maccy Paste's shortcut (Command-Shift-V) and paste-on-select.";
    };
    touchIdSudo.check = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Say at activation when /etc/pam.d/sudo_local does not enable Touch ID for sudo.";
    };
    apps = lib.mkOption {
      type = lib.types.listOf lib.types.package;
      default = [ ];
      example = lib.literalExpression "with pkgs; [ ghostty-bin raycast ]";
      description = "GUI apps from nixpkgs, copied into ~/Applications/Home Manager Apps.";
    };
    brewfile = {
      enable = lib.mkEnableOption "a Home Manager-generated Brewfile for GUI apps";
      path = lib.mkOption {
        type = lib.types.str;
        default = ".config/homebrew/Brewfile";
        description = "Where the Brewfile is written, relative to the home directory.";
      };
      taps = lib.mkOption {
        type = lib.types.listOf lib.types.str;
        default = [ ];
        description = "Third-party taps (`owner/tap`) the casks or formulae need.";
      };
      brews = lib.mkOption {
        type = lib.types.listOf lib.types.str;
        default = [ ];
        description = "Formulae. Prefer Nix for CLI tools; list here only what nixpkgs lacks.";
      };
      casks = lib.mkOption {
        type = lib.types.listOf lib.types.str;
        default = [ ];
        description = "Casks to install and keep upgraded.";
      };
    };
  };

  config = lib.mkIf pkgs.stdenv.hostPlatform.isDarwin (
    lib.mkMerge [
      (lib.mkIf (cfg.apps != [ ]) {
        home.packages = cfg.apps;
        # Copies, not links: Spotlight and Launch Services ignore symlinked
        # apps. The two are mutually exclusive.
        targets.darwin.copyApps.enable = true;
        targets.darwin.linkApps.enable = false;
      })
      (lib.mkIf cfg.maccy.enable {
        home.activation.maccyPreferences = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
          run /usr/bin/defaults write org.p0deje.Maccy KeyboardShortcuts_popup \
            -string '{"carbonKeyCode":9,"carbonModifiers":768}'
          run /usr/bin/defaults write org.p0deje.Maccy pasteByDefault -bool true
        '';
      })
      (lib.mkIf cfg.touchIdSudo.check {
        home.activation.touchIdSudoCheck = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
          if ! /usr/bin/grep -qs '^auth[[:space:]].*pam_tid\.so' /etc/pam.d/sudo_local; then
            echo "Touch ID for sudo is off. Turn it on once with: nix run ${config.dotfiles.repo.flakeDir}#touchid-sudo"
          fi
        '';
      })
      (lib.mkIf bf.enable {
        home.file.${bf.path}.text = brewfileText;
        home.sessionVariables.HOMEBREW_BUNDLE_FILE = "${config.home.homeDirectory}/${bf.path}";
        dotfiles.homebrew.enable = lib.mkDefault true;
      })
    ]
  );
}
