# The per-machine instruction file every AI tool loads, generated by Nix.
#
# Claude Code, Codex, OpenCode, Gemini CLI and Antigravity each read a global
# instruction file from a different path. This module writes one document to
# all of those paths, built at evaluation time from the configuration itself:
# the aliases are the ones Home Manager installs, the package list is the one
# declared, the runtimes come from .tool-versions, the GUI apps from the
# Brewfile and dotfiles.darwin.apps. A rebuild is the update; there is nothing
# to regenerate or commit.
#
# Your own rules for agents (how to write, what never to do) go in
# dotfiles.ai.docs.prose, from the configuration that consumes this flake.
{
  config,
  options,
  lib,
  pkgs,
  osConfig ? null,
  ...
}:

let
  cfg = config.dotfiles;
  docs = cfg.ai.docs;
  inherit (pkgs.stdenv) hostPlatform;
  inherit (hostPlatform) isDarwin;
  standalone = osConfig == null;

  archDesc =
    if hostPlatform.isAarch64 then
      (if isDarwin then "aarch64 (Apple Silicon)" else "aarch64 (ARM64)")
    else
      "x86_64";

  title =
    if isDarwin then
      (if hostPlatform.isAarch64 then "macOS (Apple Silicon)" else "macOS (x86_64)")
    else
      "Linux${lib.optionalString standalone ", standalone Home Manager"} (${archDesc})";

  intro = ''
    # Local machine profile - ${title}

    Loaded globally by every AI tool on this machine, all linked by Home Manager: Claude Code (`~/.claude/CLAUDE.md`, `~/CLAUDE.local.md`), Codex (`~/.codex/AGENTS.md`), OpenCode (`~/AGENTS.local.md`) and Gemini CLI / Antigravity (`~/.gemini/GEMINI.md`, `~/GEMINI.local.md`). It is generated from the Home Manager configuration on every switch (installed packages, aliases, apps, runtimes), so it always matches the generation that is running. To change it, change the configuration in `${cfg.repo.flakeDir}`; there is no file to edit.
  '';

  systemInfo = lib.concatStringsSep "\n" (
    [
      "## System Info"
      ""
      "- **Platform**: ${if isDarwin then "macOS (Darwin)" else "Linux"}"
      "- **Architecture**: ${archDesc}"
      "- **Config**: Nix flake at `${cfg.repo.flakeDir}` - ${
        if standalone then
          "Home Manager only (`~`), no system services"
        else
          "Home Manager inside a system flake"
      }; shared modules from dotfiles-core"
      "- **Shell**: zsh + oh-my-zsh with starship prompt (everforest powerline)"
      "- **Tool versions**: mise, pinned in `~/.tool-versions`"
      "- **Git signing**: ${
        if cfg.git.signing.key == null then
          "off"
        else if cfg.git.signing.signer != null then
          "SSH, through `${baseNameOf cfg.git.signing.signer}`"
        else
          "SSH, through `ssh-keygen`"
      }"
    ]
    ++ lib.optional isDarwin "- **Homebrew**: ${
      if cfg.homebrew.enable then "installed at `/opt/homebrew`, on PATH" else "not used"
    }"
  );

  aliases = config.programs.zsh.shellAliases;
  aliasWidth = lib.foldl' (w: n: lib.max w (builtins.stringLength n)) 0 (builtins.attrNames aliases);
  pad = s: s + lib.strings.replicate (aliasWidth - builtins.stringLength s) " ";
  aliasBlock = lib.concatMapStringsSep "\n" (n: "${pad n}  # ${aliases.${n}}") (
    lib.sort (a: b: a < b) (builtins.attrNames aliases)
  );

  keyCommands = ''
    ## Key Commands

    Run `about` (or `about <pattern>`) in zsh for the self-documenting list of aliases and functions. `nbs` switches to the new generation, ${lib.optionalString brewfile "applies the Brewfile, "}upgrades mise, then commits and pushes.

    Aliases installed by Home Manager on this machine:

    ```bash
    ${aliasBlock}
    ```
  '';

  pkgName = p: p.pname or (lib.getName p);
  isFont =
    n:
    lib.hasInfix "font" n
    || lib.hasPrefix "noto" n
    || lib.hasPrefix "dejavu" n
    || lib.hasSuffix "-mono" n;
  # nixpkgs descriptions sometimes carry em dashes; the document uses hyphens.
  firstLine =
    s: builtins.replaceStrings [ "—" ] [ "-" ] (lib.trim (builtins.head (lib.splitString "\n" s)));
  describe =
    list:
    lib.foldl' (
      acc: p:
      let
        n = pkgName p;
      in
      acc // lib.optionalAttrs (!(acc ? ${n})) { ${n} = firstLine (p.meta.description or ""); }
    ) { } (lib.filter (p: lib.isDerivation p && !(isFont (pkgName p))) list);
  packageLines = lib.mapAttrsToList (n: d: "- `${n}`${lib.optionalString (d != "") " - ${d}"}") (
    describe docs.packages
  );

  # programs.<name>.enable = true: tools configured rather than merely
  # installed. Read only options that were set; Home Manager keeps stubs for
  # removed programs whose value throws on access.
  enabledPrograms = lib.sort (a: b: a < b) (
    lib.filter (
      n:
      let
        o = options.programs.${n};
      in
      builtins.isAttrs o && o ? enable && (o.enable.isDefined or false) && config.programs.${n}.enable
    ) (builtins.attrNames options.programs)
  );

  miseTools = lib.optionals (docs.toolVersionsFile != null) (
    lib.filter (n: n != "") (
      map (
        line:
        let
          trimmed = lib.trim line;
          name = builtins.head (lib.splitString " " trimmed);
        in
        if trimmed == "" || lib.hasPrefix "#" trimmed then "" else lib.removePrefix "npm:" name
      ) (lib.splitString "\n" (builtins.readFile docs.toolVersionsFile))
    )
  );

  ticks = xs: lib.concatMapStringsSep ", " (n: "`${n}`") xs;
  sortedTicks = xs: ticks (lib.sort (a: b: a < b) xs);

  installedTools = ''
    ## Installed CLI Tools

    ### Configured through Home Manager (`programs.<name>`)
    - ${ticks enabledPrograms}
    ${lib.optionalString (miseTools != [ ]) ''

      ### Languages & Runtimes (managed by mise, see `~/.tool-versions`)
      - ${ticks miseTools}
    ''}
    ### Native installers (self-updating, in `~/.local/bin`)
    - `claude` (Claude Code), `codex`, `agy` (Antigravity)

    ### Nix packages (name - nixpkgs description)
    ${lib.concatStringsSep "\n" (lib.sort (a: b: a < b) packageLines)}
  '';

  brewfile = cfg.darwin.brewfile.enable or false;
  nixApps = map pkgName (cfg.darwin.apps or [ ]);
  guiApps = lib.concatStringsSep "\n" (
    [
      "## GUI Applications"
      ""
    ]
    ++ lib.optional brewfile "- **Homebrew casks** (`brew bundle`, from `~/${cfg.darwin.brewfile.path}`): ${sortedTicks cfg.darwin.brewfile.casks}"
    ++ lib.optional (
      brewfile && cfg.darwin.brewfile.brews != [ ]
    ) "- **Homebrew formulae**: ${sortedTicks cfg.darwin.brewfile.brews}"
    ++ lib.optional (
      nixApps != [ ]
    ) "- **Nix apps** (`~/Applications/Home Manager Apps`): ${sortedTicks nixApps}"
    ++ [ "" ]
  );

  document = lib.concatStringsSep "\n" (
    [
      intro
    ]
    ++ lib.optional (docs.prose != "") docs.prose
    ++ [
      systemInfo
      ""
      keyCommands
      installedTools
    ]
    ++ lib.optional (isDarwin && (brewfile || nixApps != [ ])) guiApps
    ++ lib.optional (docs.extraSections != "") docs.extraSections
  );

  # Codex and Antigravity need the dotdir copies because they never read
  # ~/*.local.md (Codex reads ~/.codex/AGENTS.md plus the repo's AGENTS.md;
  # Antigravity, a Gemini CLI descendant, only matches GEMINI.md under
  # ~/.gemini). OpenCode reads ~/AGENTS.local.md through `instructions` in
  # its opencode.json.
  targets = [
    "CLAUDE.local.md"
    "AGENTS.local.md"
    "GEMINI.local.md"
    ".claude/CLAUDE.md"
    ".codex/AGENTS.md"
    ".gemini/GEMINI.md"
  ];
in
{
  imports = [ ./options.nix ];

  options.dotfiles.ai.docs = {
    enable = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Write the generated instruction file to every AI tool's global path.";
    };
    prose = lib.mkOption {
      type = lib.types.lines;
      default = "";
      description = ''
        Your standing instructions for agents (rules, voice), as Markdown
        sections placed after the introduction. Keep anything private in the
        consuming configuration, not in this repository.
      '';
    };
    extraSections = lib.mkOption {
      type = lib.types.lines;
      default = "";
      description = "Markdown sections appended at the end of the document.";
    };
    packages = lib.mkOption {
      type = lib.types.listOf lib.types.package;
      default =
        lib.optionals (cfg.packages.enable or false) (
          import ../lib/packages.nix {
            inherit pkgs;
            homebrewCli = cfg.packages.homebrewCli or false;
            exclude = cfg.packages.exclude or [ ];
          }
        )
        ++ (cfg.darwin.apps or [ ]);
      defaultText = lib.literalMD "the core package list (when installed) and `dotfiles.darwin.apps`";
      description = "Packages the document lists with their nixpkgs descriptions.";
    };
    toolVersionsFile = lib.mkOption {
      type = lib.types.nullOr lib.types.path;
      default = null;
      example = lib.literalExpression "./.tool-versions";
      description = "A .tool-versions inside the consuming flake, read at evaluation to list the mise runtimes.";
    };
  };

  config = lib.mkIf docs.enable {
    home.file = lib.genAttrs targets (_: {
      text = document;
    });
  };
}
